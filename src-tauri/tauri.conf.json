{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "0.2.11",
  "identifier": "com.cadence.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cadence",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#141416",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/art/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Akbar Priyono Haryadi",
    "copyright": "© 2026 Akbar Priyono Haryadi. GPL-3.0",
    "license": "GPL-3.0-only",
    "shortDescription": "Lossless music player",
    "longDescription": "Cadence is an open-source lossless music player for your own files: bit-perfect playback, gapless, Sound Check, EQ, synced lyrics and an AI DJ.",
    "homepage": "https://cadence.akbarharyadi.com",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQjBCRjM2NjA4QjczNkMKUldSc2M0dGdOcit3SGhOVW9qc1hqQXJ4ZWJMcW4vazZvRTNLWWQvNEd6MkY3TDkwOTcxRDBPbFgK",
      "endpoints": [
        "https://github.com/akbarharyadi/cadence/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
