<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget when it's short (one row of the home screen or a launcher panel): the cover,
     the song over its waveform (filled in as it plays), and play / next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_veil" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_art_bg"
            android:clipToOutline="true"
            android:contentDescription="Open Cadence"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_stat_cadence" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Cadence"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open"
                android:textColor="#B8FFFFFF"
                android:textSize="12.5sp" />

            <ImageView
                android:id="@+id/widget_wave"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="7dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <!-- Only in the tall layout. -->
            <LinearLayout
                android:id="@+id/widget_quality_row"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_quality"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play or pause"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Next"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_next" />

        <!-- Only in the tall layout. -->
        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
