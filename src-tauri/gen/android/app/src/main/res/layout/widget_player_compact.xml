<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget when it's short (one row of the home screen or a launcher panel):
     cover, song and quality, then previous / play-pause / next, with the progress line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_veil" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/widget_art_bg"
            android:clipToOutline="true"
            android:contentDescription="Open Cadence"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_stat_cadence" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Cadence"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open"
                android:textColor="#B8FFFFFF"
                android:textSize="12.5sp" />

            <LinearLayout
                android:id="@+id/widget_quality_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_w_quality" />

                <TextView
                    android:id="@+id/widget_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFF2C26B"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_prev" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play or pause"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_bg"
            android:contentDescription="Next"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_w_next" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />
</FrameLayout>
