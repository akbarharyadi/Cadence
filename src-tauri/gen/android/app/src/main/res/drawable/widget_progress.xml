<?xml version="1.0" encoding="utf-8"?>
<!-- The thin progress line along the bottom edge (its colour follows the album). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#1FFFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#FF8B7CFF" /></shape></clip>
    </item>
</layer-list>
